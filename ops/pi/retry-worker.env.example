# Core services
PUBLISH_CACHE_ENABLED=true
PUBLISH_CACHE_DATABASE_URL=postgresql://user:password@host/db?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_xxx
ENCRYPTION_KEY=your_32_chars_secret

# Optional but recommended
CACHE_DB_URL=https://your-cache-project.supabase.co
CACHE_DB_SERVICE_KEY=sb_secret_cache_xxx
WP_HEADER_PROFILE=default
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Runtime identity
RETRY_WORKER_RUNTIME_LABEL=pi

# Safe startup defaults
RETRY_WORKER_POLL_MS=60000
RETRY_WORKER_BATCH_SIZE=2
RETRY_WORKER_MAX_ATTEMPTS=10
RETRY_WORKER_STATUSES=failed

# Start narrow, then widen after observation
# RETRY_WORKER_SITE_URLS=https://zonementale.com,https://cfaw.fr
# RETRY_WORKER_SOURCE_KINDS=custom,manual,processor
